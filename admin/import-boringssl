#!/usr/bin/env python3
"""Regenerates the BoringSSL assembly under rind/src/low/x86_64/boringssl.

Usage: admin/import-boringssl <BoringSSL checkout at REV>

aws-lc lacks BoringSSL's VAES AES-GCM kernels, so they come from BoringSSL's
pregenerated `gen/bcm`, through admin/import-aws-lc's x86_64 steps: one file
per routine and flavor holding its body for `naked_asm!`, braces doubled,
each table a `{name}` operand bound to a Rust static, and each local label
tagged with its file. Undoing those edits gives BoringSSL's text line for
line.
"""

import importlib.machinery
import importlib.util
import os
import subprocess
import sys

REV = "ed9209cff8b5a2fbc6c10050f29b3355048bda85"

ADMIN = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("import_aws_lc", os.path.join(ADMIN, "import-aws-lc"))
aws_lc = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(aws_lc)

COPYRIGHT = "Copyright 2024 The BoringSSL Authors"

IMPORTS_X86_64 = [
    {
        "source": "aes-gcm-avx2-x86_64",
        "tag": "vaes_avx2",
        "tables": ["bswap_mask", "gfpoly", "gfpoly_and_internal_carrybit", "ctr_pattern", "inc_2blocks"],
        "routines": [
            "gcm_init_vpclmulqdq_avx2",
            "gcm_ghash_vpclmulqdq_avx2",
            "aes_gcm_enc_update_vaes_avx2",
            "aes_gcm_dec_update_vaes_avx2",
        ],
    },
    {
        "source": "aes-gcm-avx512-x86_64",
        "tag": "vaes_avx512",
        "tables": ["bswap_mask", "gfpoly", "gfpoly_and_internal_carrybit", "ctr_pattern", "inc_4blocks"],
        "routines": [
            "gcm_init_vpclmulqdq_avx512",
            "gcm_ghash_vpclmulqdq_avx512",
            "aes_gcm_enc_update_vaes_avx512",
            "aes_gcm_dec_update_vaes_avx512",
        ],
    },
]


def header(comment, spec, source):
    return [
        f"{comment} {COPYRIGHT}",
        f"{comment} SPDX-License-Identifier: Apache-2.0",
        f"{comment}",
        f"{comment} Generated by admin/import-boringssl from BoringSSL {REV}:",
        f"{comment} {source}, which BoringSSL generates from crypto/fipsmodule/aes/asm/{spec['source']}.pl.",
        f"{comment} Do not edit by hand.",
    ]


def import_x86_64(boringssl):
    arch = aws_lc.ARCHES["x86_64"]
    out_dir = os.path.join(aws_lc.ROOT, "x86_64", "boringssl")
    for spec in IMPORTS_X86_64:
        for flavor, (_, defines, prefix, local) in arch["flavors"].items():
            source = os.path.join("gen", "bcm", f"{spec['source']}-{flavor}.S")
            lines = aws_lc.preprocess(os.path.join(boringssl, source), arch["cpp"] + defines)

            operands = {local + name: name for name in spec["tables"]}
            for name in spec["routines"]:
                body = aws_lc.body(lines, f"{prefix}{name}:")
                text = aws_lc.escape(body, operands, local, spec["tag"])
                out = os.path.join(out_dir, f"{name}.{flavor}.s")
                aws_lc.write(out, header(arch["comment"], spec, source) + list(text))

            if flavor != "linux":
                continue
            for name in spec["tables"]:
                values = aws_lc.table(lines, f"{local}{name}:")
                rows = [f"    {', '.join(values[i : i + 2])}," for i in range(0, len(values), 2)]
                out = os.path.join(out_dir, f"{spec['source']}.{name}.rs")
                aws_lc.write(out, header("//", spec, source) + ["["] + rows + ["]"])


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    boringssl = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", boringssl, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"BoringSSL is at {rev}, expected {REV}")

    import_x86_64(boringssl)


if __name__ == "__main__":
    main()
