#!/usr/bin/env python3
"""Regenerates the BoringSSL assembly under rind/src/low/*/boringssl.

Usage: admin/import-boringssl <BoringSSL checkout at REV>

aws-lc lacks these, so they come from BoringSSL, through admin/import-aws-lc's
steps: braces doubled, each routine or table a `{name}` operand, and each local
label tagged with its file. Undoing those edits gives BoringSSL's text line for
line.

x86_64: BoringSSL's VAES AES-GCM kernels, from its pregenerated `gen/bcm`. One
file per routine and flavor holds its body for `naked_asm!`, and each table is
bound to a Rust static.

32-bit ARM: BoringSSL's NEON X25519, which is hand-written rather than
generated. cpp runs for ARM mode, the file is kept whole for `global_asm!`
without its license comment, which the header restates, and the routine's name
is bound to a crate-version qualified symbol.
"""

import importlib.machinery
import importlib.util
import os
import subprocess
import sys

REV = "ed9209cff8b5a2fbc6c10050f29b3355048bda85"

ADMIN = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("import_aws_lc", os.path.join(ADMIN, "import-aws-lc"))
aws_lc = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(aws_lc)

IMPORTS_X86_64 = [
    {
        "source": "aes-gcm-avx2-x86_64",
        "tag": "vaes_avx2",
        "tables": ["bswap_mask", "gfpoly", "gfpoly_and_internal_carrybit", "ctr_pattern", "inc_2blocks"],
        "routines": [
            "gcm_init_vpclmulqdq_avx2",
            "aes_gcm_enc_update_vaes_avx2",
            "aes_gcm_dec_update_vaes_avx2",
        ],
    },
    {
        "source": "aes-gcm-avx512-x86_64",
        "tag": "vaes_avx512",
        "tables": ["bswap_mask", "gfpoly", "gfpoly_and_internal_carrybit", "ctr_pattern", "inc_4blocks"],
        "routines": [
            "gcm_init_vpclmulqdq_avx512",
            "aes_gcm_enc_update_vaes_avx512",
            "aes_gcm_dec_update_vaes_avx512",
        ],
    },
]

IMPORTS_ARM = [
    {
        "source": "crypto/curve25519/asm/x25519-asm-arm.S",
        "tag": "x25519",
        "copyright": [
            "Copyright 2015 The BoringSSL Authors",
            "From crypto_scalarmult/curve25519/neon2/scalarmult.s in SUPERCOP",
            "20141124, which is public domain.",
        ],
        "routines": ["x25519_NEON"],
    },
]


def header(comment, copyright, source):
    return [f"{comment} {line}" for line in copyright] + [
        f"{comment} SPDX-License-Identifier: Apache-2.0",
        f"{comment}",
        f"{comment} Generated by admin/import-boringssl from BoringSSL {REV}:",
        f"{comment} {source}",
        f"{comment} Do not edit by hand.",
    ]


def import_x86_64(boringssl):
    arch = aws_lc.ARCHES["x86_64"]
    out_dir = os.path.join(aws_lc.ROOT, "x86_64", "boringssl")
    for spec in IMPORTS_X86_64:
        for flavor, (_, defines, prefix, local) in arch["flavors"].items():
            source = os.path.join("gen", "bcm", f"{spec['source']}-{flavor}.S")
            lines = aws_lc.preprocess(os.path.join(boringssl, source), arch["cpp"] + defines)
            copyright = ["Copyright 2024 The BoringSSL Authors"]
            origin = f"{source}, which BoringSSL generates from crypto/fipsmodule/aes/asm/{spec['source']}.pl."

            operands = {local + name: name for name in spec["tables"]}
            for name in spec["routines"]:
                body = aws_lc.body(lines, f"{prefix}{name}:")
                text = aws_lc.escape(body, operands, local, spec["tag"])
                out = os.path.join(out_dir, f"{name}.{flavor}.s")
                aws_lc.write(out, header(arch["comment"], copyright, origin) + list(text))

            if flavor != "linux":
                continue
            for name in spec["tables"]:
                values = aws_lc.table(lines, f"{local}{name}:")
                rows = [f"    {', '.join(values[i : i + 2])}," for i in range(0, len(values), 2)]
                out = os.path.join(out_dir, f"{spec['source']}.{name}.rs")
                aws_lc.write(out, header("//", copyright, origin) + ["["] + rows + ["]"])


def import_arm(boringssl):
    out_dir = os.path.join(aws_lc.ROOT, "arm", "boringssl")
    for spec in IMPORTS_ARM:
        lines = aws_lc.preprocess(os.path.join(boringssl, spec["source"]), aws_lc.ARM_CPP)
        # Traditional cpp keeps the `//` license comment; the header restates it.
        while not lines[0].strip() or lines[0].startswith("//"):
            lines.pop(0)

        operands = {name: name for name in spec["routines"]}
        text = aws_lc.escape(lines, operands, "._", spec["tag"])
        out = os.path.join(out_dir, os.path.basename(spec["source"]).removesuffix(".S") + ".s")
        aws_lc.write(out, header("@", spec["copyright"], f"{spec['source']}.") + list(text))


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    boringssl = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", boringssl, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"BoringSSL is at {rev}, expected {REV}")

    import_x86_64(boringssl)
    import_arm(boringssl)


if __name__ == "__main__":
    main()
