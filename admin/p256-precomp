#!/usr/bin/env python3
#
# Writes rind/src/mid/p256/precomp.rs, the P-256 generator table, from
# Python's integers rather than rind's arithmetic, which the
# `p256::tests::base_point_precomp_w6` test then checks it against.
#
# Row j holds i * 2^(6 * j) * G for i in 1..=32, as affine points with
# Montgomery coordinates, each 4 little-endian 64-bit words: the layout
# s2n-bignum's `p256_scalarmulbase` reads with a block size of 6.

import pathlib

P = 2**256 - 2**224 + 2**192 + 2**96 - 1
GX = 0x6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296
GY = 0x4FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5

ROWS = 256 // 6 + 1
POINTS = 32


def add(p1, p2):
    # Affine addition; never reaches infinity, since the table only holds
    # multiples below the group order.
    (x1, y1), (x2, y2) = p1, p2
    if p1 == p2:
        m = (3 * x1 * x1 - 3) * pow(2 * y1, -1, P)
    else:
        m = (y2 - y1) * pow(x2 - x1, -1, P)
    x3 = (m * m - x1 - x2) % P
    return x3, (m * (x1 - x3) - y1) % P


def words(v):
    v = (v << 256) % P
    return [(v >> (64 * i)) & (2**64 - 1) for i in range(4)]


out = [
    "// This file is generated by `admin/p256-precomp`; do not edit.",
    "// SPDX-License-Identifier: Apache-2.0 OR ISC OR MIT-0",
    "",
    "pub(super) static CURVE_GENERATOR_PRECOMP_W6: super::AffineMontPointTableW6 = [",
]

base = (GX, GY)
for j in range(ROWS):
    out.append(f"    // 1G..{POINTS}G << {6 * j}")
    out.append("    [")
    point = base
    for i in range(1, POINTS + 1):
        for coord in point:
            out.extend(f"        0x{w:016x}," for w in words(coord))
        if i < POINTS:
            point = add(point, base)
    out.append("    ],")
    for _ in range(6):
        base = add(base, base)
out.append("];")

path = pathlib.Path(__file__).resolve().parent.parent / "rind/src/mid/p256/precomp.rs"
path.write_text("\n".join(out) + "\n")
