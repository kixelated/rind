#!/usr/bin/env python3
#
# Writes rind/src/mid/p384/precomp.rs, the P-384 generator table, from
# Python's integers rather than rind's arithmetic, which the
# `p384::tests::base_point_precomp_comb` test then checks it against.
#
# Table j holds i * 2^(20 * j) * G for i in 1..=16, as affine points with
# Montgomery coordinates, each 6 little-endian 64-bit words.

import pathlib

P = 2**384 - 2**128 - 2**96 + 2**32 - 1
GX = 0xAA87CA22BE8B05378EB1C71EF320AD746E1D3B628BA79B9859F741E082542A385502F25DBF55296C3A545E3872760AB7
GY = 0x3617DE4A96262C6F5D9E98BF9292DC29F8F41DBD289A147CE9DA3113B5F0B8C00A60B1CE1D7E819D7A431D7C90EA0E5F

TABLES = 20
POINTS = 16


def add(p1, p2):
    # Affine addition; never reaches infinity, since the table only holds
    # multiples below the group order.
    (x1, y1), (x2, y2) = p1, p2
    if p1 == p2:
        m = (3 * x1 * x1 - 3) * pow(2 * y1, -1, P)
    else:
        m = (y2 - y1) * pow(x2 - x1, -1, P)
    x3 = (m * m - x1 - x2) % P
    return x3, (m * (x1 - x3) - y1) % P


def words(v):
    v = (v << 384) % P
    return [(v >> (64 * i)) & (2**64 - 1) for i in range(6)]


out = [
    "// This file is generated by `admin/p384-precomp`; do not edit.",
    "// SPDX-License-Identifier: Apache-2.0 OR ISC OR MIT-0",
    "",
    "pub(super) static CURVE_GENERATOR_PRECOMP_COMB: super::AffineMontPointTableComb = [",
]

base = (GX, GY)
for j in range(TABLES):
    out.append(f"    // 1G..{POINTS}G << {20 * j}")
    out.append("    [")
    point = base
    for i in range(1, POINTS + 1):
        for coord in point:
            out.extend(f"        0x{w:016x}," for w in words(coord))
        if i < POINTS:
            point = add(point, base)
    out.append("    ],")
    for _ in range(20):
        base = add(base, base)
out.append("];")

path = pathlib.Path(__file__).resolve().parent.parent / "rind/src/mid/p384/precomp.rs"
path.write_text("\n".join(out) + "\n")
