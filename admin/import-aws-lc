#!/usr/bin/env python3
"""Regenerates the aws-lc assembly under rind/src/low/*/aws_lc.

Usage: admin/import-aws-lc <aws-lc checkout at REV>

Every output starts from one of aws-lc's pregenerated `generated-src` files,
run through cpp, and is escaped for Rust's assembly macros: braces doubled,
each table a routine loads a `{name}` operand, and each local label tagged
with its file, since the blocks can share an assembler scope. Undoing those
edits gives aws-lc's text line for line.

32-bit ARM: one file per source, for `global_asm!`, from the `linux-arm`
flavor cut down to the routines rind calls and the tables they load. Each
routine's name is a `{name}` operand that rind binds to a crate-version
qualified symbol.

x86_64 and aarch64: one file per routine and flavor, holding the routine's
body from after its label through its return, for `naked_asm!` in a naked
function. rustc then emits the symbol, section, and alignment directives for
the object format, so aws-lc's `linux` flavor serves ELF and COFF, and its
Apple flavor, which spells alignment and page relocations differently, serves
Mach-O. The tables move to Rust statics, written as array literals beside the
routines, which the routines reach through `sym` operands.
"""

import os
import re
import subprocess
import sys

REV = "91c93a8eb860e51482a871a8772cb9b1b310baea"

ROOT = os.path.join(os.path.dirname(__file__), "..", "rind", "src", "low")

# ARM mode, little-endian, built for ARMv7 with the ARMv8 routines kept, as
# aws-lc builds them for 32-bit Android and Linux.
ARM_CPP = [
    "-D__ARMEL__",
    "-D__ARM_ARCH=7",
    "-D__ARM_MAX_ARCH__=8",
    "-DOPENSSL_ARM",
    "-D__ELF__",
    "-DAARCH64_VALID_CALL_TARGET=",
]

ARM_IMPORTS = [
    {
        "source": "aesv8-armx.S",
        "tag": "aes",
        "perlasm": "crypto/fipsmodule/aes/asm/aesv8-armx.pl",
        "copyright": "Copyright 2014-2016 The OpenSSL Project Authors. All Rights Reserved.",
        "constants": [(".Lrcon:", 3)],
        "routines": [
            "aes_hw_set_encrypt_key",
            "aes_hw_encrypt",
            "aes_hw_ctr32_encrypt_blocks",
        ],
    },
    {
        "source": "ghashv8-armx.S",
        "tag": "ghash",
        "perlasm": "crypto/fipsmodule/modes/asm/ghashv8-armx.pl",
        "copyright": "Copyright 2014-2020 The OpenSSL Project Authors. All Rights Reserved.",
        "constants": [],
        "routines": ["gcm_init_v8", "gcm_ghash_v8"],
    },
    {
        "source": "sha1-armv4-large.S",
        "tag": "sha1",
        "perlasm": "crypto/fipsmodule/sha/asm/sha1-armv4-large.pl",
        "copyright": "Copyright 2007-2016 The OpenSSL Project Authors. All Rights Reserved.",
        "constants": [(".LK_00_19:.word", 3)],
        "routines": ["sha1_block_data_order_hw"],
    },
    {
        "source": "sha256-armv4.S",
        "tag": "sha256",
        "perlasm": "crypto/fipsmodule/sha/asm/sha256-armv4.pl",
        "copyright": "Copyright 2007-2016 The OpenSSL Project Authors. All Rights Reserved.",
        "constants": [("K256:", 16), (".LK256_shortcut_hw:", 2)],
        "routines": ["sha256_block_data_order_hw"],
    },
    {
        "source": "sha512-armv4.S",
        "tag": "sha512",
        "perlasm": "crypto/fipsmodule/sha/asm/sha512-armv4.pl",
        "copyright": "Copyright 2007-2016 The OpenSSL Project Authors. All Rights Reserved.",
        "constants": [("K512:", 40)],
        "routines": ["sha512_block_data_order_nohw", "sha512_block_data_order_neon"],
    },
]

# Per architecture: the comment leader, and per flavor its directory, the
# defines that select it, its symbol prefix, and its local label prefix.
ARCHES = {
    "x86_64": {
        "comment": "#",
        "cpp": ["-DOPENSSL_X86_64", "-D_CET_ENDBR="],
        "flavors": {
            "linux": ("linux-x86_64", ["-D__ELF__"], "", ".L"),
            "apple": ("mac-x86_64", ["-D__APPLE__"], "_", "L$"),
        },
    },
    "aarch64": {
        "comment": "//",
        "cpp": [
            "-DOPENSSL_AARCH64",
            "-DAARCH64_VALID_CALL_TARGET=",
            "-DAARCH64_SIGN_LINK_REGISTER=",
            "-DAARCH64_VALIDATE_LINK_REGISTER=",
        ],
        "flavors": {
            "linux": ("linux-aarch64", ["-D__ELF__"], "", ".L"),
            "apple": ("ios-aarch64", ["-D__APPLE__"], "_", "L"),
        },
    },
}

IMPORTS_64 = [
    {
        "arch": "x86_64",
        "source": "sha512-x86_64.S",
        "tag": "sha512",
        "perlasm": "crypto/fipsmodule/sha/asm/sha512-x86_64.pl",
        "copyright": "Copyright 2005-2016 The OpenSSL Project Authors. All Rights Reserved.",
        "tables": ["K512"],
        "routines": ["sha512_block_data_order_avx", "sha512_block_data_order_nohw"],
    },
    {
        "arch": "aarch64",
        "source": "sha512-armv8.S",
        "tag": "sha512",
        "perlasm": "crypto/fipsmodule/sha/asm/sha512-armv8.pl",
        "copyright": "Copyright 2014-2020 The OpenSSL Project Authors. All Rights Reserved.",
        "tables": ["K512"],
        "routines": ["sha512_block_data_order_nohw", "sha512_block_data_order_hw"],
    },
]


def preprocess(path, defines):
    # The headers only define what the defines already do, or macros for
    # other architectures.
    include = re.compile(r"#\s*include <openssl/")
    with open(path) as f:
        text = "".join(line for line in f if not include.match(line))
    cpp = ["cpp", "-traditional-cpp", "-P", "-undef", "-nostdinc", *defines, "-"]
    out = subprocess.run(cpp, input=text, capture_output=True, text=True, check=True)
    return out.stdout.splitlines()


def find(lines, words, start=0):
    for i in range(start, len(lines)):
        if lines[i].split() == words:
            return i
    sys.exit(f"missing line: {' '.join(words)}")


def constant(lines, label, following):
    """`label`'s line and the `following` lines, after any `.align` before it."""
    for i, line in enumerate(lines):
        if line.startswith(label):
            if lines[i - 1].split()[:1] == [".align"]:
                i -= 1
                following += 1
            return lines[i : i + 1 + following]
    sys.exit(f"missing constant: {label}")


def routine(lines, name):
    """`name` from its `.globl` through its `.size`."""
    start = find(lines, [".globl", name])
    end = find(lines, [".size", f"{name},.-{name}"], start)
    return lines[start : end + 1]


def body(lines, label):
    """What follows `label` up to the next directive that ends a routine."""
    start = find(lines, [label]) + 1
    end = start
    while end < len(lines) and lines[end].split()[:1] not in (
        [".size"],
        [".section"],
        [".text"],
        [".globl"],
    ):
        end += 1
    while lines[end - 1].strip() == "":
        end -= 1
    return lines[start:end]


def table(lines, label):
    """The `.quad` values from `label` up to the first line that is not one."""
    start = find(lines, [label]) + 1
    values = []
    for line in lines[start:]:
        words = re.sub(r"(//|#).*", "", line).replace(",", " ").split()
        if not words:
            continue
        if words[0] != ".quad":
            break
        values += words[1:]
    if not values:
        sys.exit(f"empty table: {label}")
    return values


def words(names):
    """Matches any of `names` as a whole symbol."""
    return re.compile(r"(?<![\w.$])(" + "|".join(map(re.escape, names)) + r")(?![\w$])")


def escape(lines, operands, local, tag):
    """Doubles braces, writes each key of `operands` as its `{operand}`, and
    tags each label `lines` defines with the `local` prefix."""
    lines = list(lines)
    defined = re.compile(re.escape(local) + r"[\w$]+(?=:)")
    labels = [m[0] for m in map(defined.match, lines) if m]
    operands_re = words(operands)
    labels_re = words(labels) if labels else None
    for line in lines:
        line = line.replace("{", "{{").replace("}", "}}")
        line = operands_re.sub(lambda m: "{" + operands[m[1]] + "}", line)
        if labels_re:
            line = labels_re.sub(lambda m: local + tag + "_" + m[1][len(local) :], line)
        yield line


def header(comment, spec, source):
    return [
        f"{comment} {spec['copyright']}",
        f"{comment} SPDX-License-Identifier: Apache-2.0",
        f"{comment}",
        f"{comment} Generated by admin/import-aws-lc from aws-lc {REV}:",
        f"{comment} {source}, which aws-lc generates from {spec['perlasm']}.",
        f"{comment} Do not edit by hand.",
    ]


def write(path, lines):
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


def import_arm(aws_lc):
    out_dir = os.path.join(ROOT, "arm", "aws_lc")
    for spec in ARM_IMPORTS:
        source = os.path.join("generated-src", "linux-arm", "crypto", "fipsmodule", spec["source"])
        lines = preprocess(os.path.join(aws_lc, source), ARM_CPP)

        text = []
        for label, following in spec["constants"]:
            text += constant(lines, label, following)
        for name in spec["routines"]:
            text += routine(lines, name)

        out = os.path.join(out_dir, spec["source"].removesuffix(".S") + ".s")
        operands = {name: name for name in spec["routines"]}
        write(out, header("@", spec, source) + list(escape(text, operands, ".L", spec["tag"])))


def import_64(aws_lc):
    for spec in IMPORTS_64:
        arch = ARCHES[spec["arch"]]
        out_dir = os.path.join(ROOT, spec["arch"], "aws_lc")
        stem = spec["source"].removesuffix(".S")
        for flavor, (directory, defines, prefix, local) in arch["flavors"].items():
            source = os.path.join("generated-src", directory, "crypto", "fipsmodule", spec["source"])
            lines = preprocess(os.path.join(aws_lc, source), arch["cpp"] + defines)

            # A flavor names a table with or without its local prefix.
            operands = {s: name for name in spec["tables"] for s in (name, local + name)}
            for name in spec["routines"]:
                text = escape(body(lines, f"{prefix}{name}:"), operands, local, spec["tag"])
                write(os.path.join(out_dir, f"{name}.{flavor}.s"), header(arch["comment"], spec, source) + list(text))

            if flavor != "linux":
                continue
            for name in spec["tables"]:
                label = next(s for s, t in operands.items() if t == name and [s + ":"] in map(str.split, lines))
                values = table(lines, label + ":")
                rows = [f"    {', '.join(values[i : i + 2])}," for i in range(0, len(values), 2)]
                write(os.path.join(out_dir, f"{stem}.{name}.rs"), header("//", spec, source) + ["["] + rows + ["]"])


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    aws_lc = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", aws_lc, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"aws-lc is at {rev}, expected {REV}")

    import_arm(aws_lc)
    import_64(aws_lc)


if __name__ == "__main__":
    main()
