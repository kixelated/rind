#!/usr/bin/env bash

set -e

# for branch coverage support, which is unstable
export RUSTC_BOOTSTRAP=1
OPTIONS=--branch

cargo llvm-cov show-env --export-prefix $OPTIONS "$@" > envsh
source ./envsh
cargo llvm-cov clean --workspace

env SLOW_TESTS=1 cargo test --locked

case `uname -m` in
    x86_64)
        env RIND_CPU_DISABLE_sha=1 RIND_CPU_DISABLE_intel=1 RIND_CPU_DISABLE_avx512bw=1 RIND_CPU_DISABLE_avx512f=1 RIND_CPU_DISABLE_vaes=1 cargo test --locked
        env CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER="sde -dmr --" cargo test --locked
        ;;
    arm|arm64|aarch64)
        env RIND_CPU_DISABLE_sha3=1 RIND_CPU_DISABLE_dit=1 cargo test --locked
        ;;
esac

cargo run --example client https://jbp.io >/dev/null

cargo llvm-cov report $OPTIONS "$@"
