# Memcheck findings in dependencies that rind cannot fix in its own code.

# libcrux decides whether a tag verified, then branches on that decision. The
# outcome is public, but libcrux does not declassify it for memcheck.
{
   libcrux-aes-gcm-decrypt-outcome
   Memcheck:Cond
   src:aes_gcm.rs:99
   fun:*libcrux_aes*
}

# Unoptimised, libcrux's P-256 Diffie-Hellman branches on its check that the
# private scalar is in range. rind's scalars always are, so the outcome is
# public, but libcrux does not declassify it for memcheck.
{
   libcrux-p256-dh-scalar-check
   Memcheck:Cond
   src:p256.rs:1571
   fun:*libcrux_p256*
}
