#!/usr/bin/env python3
"""Regenerates rind/src/low/arm/aws_lc/*.s from aws-lc's AArch32 assembly.

Usage: admin/import-aws-lc-arm <aws-lc checkout at REV>

Each output is one of aws-lc's 32-bit ARM assembly files, mostly the
pregenerated `generated-src/linux-arm` ones, run through cpp for ARM mode, cut
down to the routines rind calls and the constants they load, then escaped for
`global_asm!`: braces doubled, each routine's name a `{name}` operand that rind
binds to a crate-version qualified symbol, and each local label (`.L` or `._`)
tagged with its file, since `global_asm!` blocks can share an assembler scope.
Undoing those three edits gives aws-lc's text line for line.
"""

import os
import re
import subprocess
import sys

REV = "91c93a8eb860e51482a871a8772cb9b1b310baea"

# ARM mode, little-endian, built for ARMv7 with the ARMv8 routines kept, as
# aws-lc builds them for 32-bit Android and Linux.
CPP = [
    "cpp",
    "-x",
    "assembler-with-cpp",
    "-traditional-cpp",
    "-P",
    "-undef",
    "-nostdinc",
    "-D__ARMEL__",
    "-D__ARM_ARCH=7",
    "-D__ARM_MAX_ARCH__=8",
    "-DOPENSSL_ARM",
    "-D__ELF__",
    "-DAARCH64_VALID_CALL_TARGET=",
    "-",
]

FIPS = "generated-src/linux-arm/crypto/fipsmodule/"
OPENSSL = "The OpenSSL Project Authors. All Rights Reserved."
APACHE = "SPDX-License-Identifier: Apache-2.0"

IMPORTS = [
    {
        "source": FIPS + "aesv8-armx.S",
        "tag": "aes",
        "perlasm": "crypto/fipsmodule/aes/asm/aesv8-armx.pl",
        "notice": [f"Copyright 2014-2016 {OPENSSL}", APACHE],
        "constants": [(".Lrcon:", 3)],
        "routines": [
            "aes_hw_set_encrypt_key",
            "aes_hw_encrypt",
            "aes_hw_ctr32_encrypt_blocks",
        ],
    },
    {
        "source": FIPS + "ghashv8-armx.S",
        "tag": "ghash",
        "perlasm": "crypto/fipsmodule/modes/asm/ghashv8-armx.pl",
        "notice": [f"Copyright 2014-2020 {OPENSSL}", APACHE],
        "constants": [],
        "routines": ["gcm_init_v8", "gcm_ghash_v8"],
    },
    {
        "source": FIPS + "sha1-armv4-large.S",
        "tag": "sha1",
        "perlasm": "crypto/fipsmodule/sha/asm/sha1-armv4-large.pl",
        "notice": [f"Copyright 2007-2016 {OPENSSL}", APACHE],
        "constants": [(".LK_00_19:.word", 3)],
        "routines": ["sha1_block_data_order_hw"],
    },
    {
        "source": FIPS + "sha256-armv4.S",
        "tag": "sha256",
        "perlasm": "crypto/fipsmodule/sha/asm/sha256-armv4.pl",
        "notice": [f"Copyright 2007-2016 {OPENSSL}", APACHE],
        "constants": [("K256:", 16), (".LK256_shortcut_hw:", 2)],
        "routines": ["sha256_block_data_order_hw"],
    },
    {
        "source": "generated-src/linux-arm/crypto/chacha/chacha-armv4.S",
        "tag": "chacha",
        "perlasm": "crypto/chacha/asm/chacha-armv4.pl",
        "notice": [f"Copyright 2016 {OPENSSL}", APACHE],
        "constants": [(".Lsigma:", 3)],
        "routines": ["ChaCha20_ctr32_nohw", "ChaCha20_ctr32_neon"],
    },
    # Written by hand rather than generated, and its routines end without
    # `.size`, so the whole file is kept. aws-lc keeps BoringSSL's ISC license
    # for it.
    {
        "source": "crypto/poly1305/poly1305_arm_asm.S",
        "tag": "poly1305",
        "notice": [
            "Public domain: the neon2 version in SUPERCOP by D. J. Bernstein and",
            "Peter Schwabe, as BoringSSL imported it. Copyright (c) 2014, Google Inc.",
            "SPDX-License-Identifier: ISC",
        ],
        "constants": [],
        "routines": ["openssl_poly1305_neon2_blocks", "openssl_poly1305_neon2_addmulmod"],
        "whole": True,
    },
]


def preprocess(path):
    # The headers only define what CPP already does, or AArch64 macros.
    include = re.compile(r"#\s*include <openssl/")
    with open(path) as f:
        text = "".join(line for line in f if not include.match(line))
    out = subprocess.run(CPP, input=text, capture_output=True, text=True, check=True)
    return out.stdout.splitlines()


def find(lines, words, start=0):
    for i in range(start, len(lines)):
        if lines[i].split() == words:
            return i
    sys.exit(f"missing line: {' '.join(words)}")


def constant(lines, label, following):
    """`label`'s line and the `following` lines, after any `.align` before it."""
    for i, line in enumerate(lines):
        if line.startswith(label):
            if lines[i - 1].split()[:1] == [".align"]:
                i -= 1
                following += 1
            return lines[i : i + 1 + following]
    sys.exit(f"missing constant: {label}")


def routine(lines, name):
    """`name` from its `.globl` through its `.size`."""
    start = find(lines, [".globl", name])
    end = find(lines, [".size", f"{name},.-{name}"], start)
    return lines[start : end + 1]


def escape(lines, routines, tag):
    names = re.compile(r"\b(" + "|".join(routines) + r")\b")
    labels = re.compile(r"(?<![\w.])\.(L|_)(\w+)")
    for line in lines:
        line = line.replace("{", "{{").replace("}", "}}")
        line = labels.sub(rf".\1{tag}_\2", line)
        yield names.sub(r"{\1}", line)


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    aws_lc = sys.argv[1]
    rev = subprocess.run(
        ["git", "-C", aws_lc, "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if rev != REV:
        sys.exit(f"aws-lc is at {rev}, expected {REV}")

    out_dir = os.path.join(os.path.dirname(__file__), "..", "rind", "src", "low", "arm", "aws_lc")
    for spec in IMPORTS:
        source = spec["source"]
        lines = preprocess(os.path.join(aws_lc, source))

        if spec.get("whole"):
            body = "\n".join(lines).strip("\n").split("\n")
        else:
            body = []
            for label, following in spec["constants"]:
                body += constant(lines, label, following)
            for name in spec["routines"]:
                body += routine(lines, name)

        origin = f"@ {source}"
        if "perlasm" in spec:
            origin += f", which aws-lc generates from {spec['perlasm']}"
        header = [f"@ {line}" for line in spec["notice"]] + [
            "@",
            f"@ Generated by admin/import-aws-lc-arm from aws-lc {REV}:",
            origin + ".",
            "@ Do not edit by hand.",
        ]
        out = os.path.join(out_dir, os.path.basename(source).removesuffix(".S") + ".s")
        with open(out, "w") as f:
            f.write("\n".join(header + list(escape(body, spec["routines"], spec["tag"]))) + "\n")


if __name__ == "__main__":
    main()
